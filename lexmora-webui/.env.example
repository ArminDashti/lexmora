# Vite dev server proxy target (npm run dev)
VITE_API_PROXY_TARGET=http://localhost:8080

# Absolute API origin for Cloudflare Workers / separate hosts (no trailing slash).
# Leave empty for same-origin / nginx proxy (local Docker).
# VITE_API_BASE_URL=https://lexmora-api.<subdomain>.workers.dev

# Docker Compose
# WEB_PUBLISH_PORT=8082
# API_HOST=lexmora-api
# API_PORT=8080
# DOCKER_NETWORK=lexmora-net
